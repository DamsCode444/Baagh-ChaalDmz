# Your existing turbo_db_url / turbo_db_token names are also supported.
TURSO_DATABASE_URL=libsql://your-database.turso.io
TURSO_AUTH_TOKEN=your-token
PORT=3000
HOST=0.0.0.0
RECONNECT_GRACE_MS=90000
ROOM_TTL_MS=86400000
# Database HTTP connections use HTTPS_PROXY / HTTP_PROXY / NO_PROXY when set.
# On Windows, the enabled system proxy is detected automatically.
# Optional override (use "direct" to disable all database proxies):
# DATABASE_PROXY_URL=http://127.0.0.1:7877
# DATABASE_USE_SYSTEM_PROXY=false
# Maximum time for one database HTTP request, including its response body.
DATABASE_REQUEST_TIMEOUT_MS=5000
# Structured logs print to the terminal and append to this private file.
LOG_LEVEL=info
LOG_FILE=.data/server.log
# LOG_LEVEL=debug for additional detail, or silent to disable logging.
# Optional: comma-separated public origins when serving behind a proxy.
# ALLOWED_ORIGINS=https://your-game.example
# For local development without Turso, omit the credentials above and use:
# DATABASE_URL=file:.data/baagh-chaal.db
