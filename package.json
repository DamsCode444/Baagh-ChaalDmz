{
  "name": "baagh-chaal",
  "version": "1.0.0",
  "private": true,
  "description": "Baagh-Chaal with computer play and persistent room-based multiplayer",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node server/index.cjs",
    "dev": "node --watch server/index.cjs",
    "test": "node --test --test-concurrency=1 tests/*.test.cjs",
    "db:check": "node server/check-db.cjs"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.4",
    "undici": "^7.30.0"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "socket.io-client": "^4.8.4"
  }
}
